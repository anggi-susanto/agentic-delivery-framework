{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anggi-susanto/agentic-delivery-framework/schemas/scope-handshake.schema.json",
  "title": "Agentic Delivery Scope Handshake",
  "type": "object",
  "required": ["version", "task_id", "contract_sha256", "lane", "objective", "allowed_paths", "frozen_invariants", "required_red_tests", "acceptance_commands", "final_reviewer_route", "no_files_changed", "commit_allowed_now"],
  "properties": {
    "version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lane": {"enum": ["high-risk", "escalation"]},
    "objective": {"type": "string", "minLength": 1},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "frozen_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_red_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "final_reviewer_route": {"type": "string", "minLength": 1},
    "no_files_changed": {"const": true},
    "commit_allowed_now": {"const": false}
  },
  "additionalProperties": false
}
