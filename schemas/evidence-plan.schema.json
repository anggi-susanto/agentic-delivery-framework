{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anggi-susanto/agentic-delivery-framework/schemas/evidence-plan.schema.json",
  "title": "Agentic Delivery Evidence Plan",
  "type": "object",
  "required": ["version", "task_id", "contract_sha256", "verifier", "proof_items"],
  "properties": {
    "version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verifier": {"type": "string", "minLength": 1},
    "proof_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "command", "environment", "artifact_ref"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "artifact_ref": {"type": "string", "pattern": "^artifacts/[a-z0-9][a-z0-9._/-]*\\.sha256$"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
